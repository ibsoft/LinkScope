<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <ProjectGuid>{D8F9E787-DC62-4FAF-B2DF-C2FC659E0D8B}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <AssemblyName>LinkScopeSetup</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>5</LangVersion>
    <Optimize>true</Optimize>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <ApplicationManifest>setup.manifest</ApplicationManifest>
    <ApplicationIcon>..\linkscope.ico</ApplicationIcon>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <OutputPath Condition="'$(OutputPath)' == ''">bin\$(Configuration)\</OutputPath>
    <LinkScopePayload Condition="'$(LinkScopePayload)' == ''">$(MSBuildProjectDirectory)\..\bin\$(Configuration)\LinkScope.exe</LinkScopePayload>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
    <Compile Include="Setup.cs" />
    <Compile Include="..\src\CanaryTemplates.cs" />
    <Compile Include="..\src\ClamUpdateWorker.cs" />
    <Compile Include="ClamSetup.cs" />
    <Compile Include="ClamSignature.cs" />
    <EmbeddedResource Include="cisco-talos.gpg">
      <LogicalName>cisco-talos.gpg</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="$(LinkScopePayload)">
      <LogicalName>LinkScope.exe</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="wizard.ps1">
      <LogicalName>wizard.ps1</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="VerifySetupInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(LinkScopePayload)')" Text="Build LinkScope first. Setup payload missing: $(LinkScopePayload)" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\cisco-talos.gpg')" Text="Missing embedded Cisco Talos release signing key." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\wizard.ps1')" Text="Setup wizard source is missing." />
  </Target>
</Project>
