  </Target>
  <Target Name="GenerateLinkScopeVersion" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\Write-BuildVersion.ps1&quot; -OutputPath &quot;$(MSBuildProjectDirectory)\obj\LinkScopeVersion.txt&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup><FileWrites Include="$(MSBuildProjectDirectory)\obj\LinkScopeVersion.txt" /></ItemGroup>
  </Target>
  <Target Name="RefreshLinkScopeCompileItems" BeforeTargets="BeforeCompile;CoreCompile" Condition="'$(DesignTimeBuild)' != 'true' And '$(SkipCompilerExecution)' != 'true'">
    <!-- Legacy VS can retain a stale evaluated item list. Re-enumerate flat src at execution time,
         preserving framework-generated and other non-src Compile items and their metadata. -->
    <ItemGroup>
      <_LinkScopeFreshSources Include="$(MSBuildProjectDirectory)\src\*.cs" />
      <_LinkScopeOtherSources Include="@(Compile)" Condition="'%(Compile.RootDir)%(Compile.Directory)' != '$(MSBuildProjectDirectory)\src\'" />
      <Compile Remove="@(Compile)" />
      <Compile Include="@(_LinkScopeFreshSources);@(_LinkScopeOtherSources)" />
    </ItemGroup>
    <Error Condition="'@(_LinkScopeFreshSources)' == ''" Text="LinkScope source directory is empty: $(MSBuildProjectDirectory)\src" />
    <Message Text="LinkScope refreshed @(_LinkScopeFreshSources->Count()) application C# inputs from disk." Importance="high" />
  </Target>
  <Target Name="VerifyEndpointProtectionSource" BeforeTargets="CoreCompile" DependsOnTargets="RefreshLinkScopeCompileItems" Condition="'$(DesignTimeBuild)' != 'true' And '$(SkipCompilerExecution)' != 'true'">
    <!-- Write actual compiler item identities; the preflight resolves them relative to the project root. -->
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)LinkScopeCompileItems.txt" Lines="@(Compile)" Overwrite="true" Encoding="UTF-8" />
    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\Assert-EndpointSources.ps1&quot; -CompileList &quot;$(IntermediateOutputPath)LinkScopeCompileItems.txt&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup><FileWrites Include="$(IntermediateOutputPath)LinkScopeCompileItems.txt" /></ItemGroup>
  </Target>
