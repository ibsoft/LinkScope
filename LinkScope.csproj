  <Target Name="BuildLinkScopeSetup" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' And '$(SkipCompilerExecution)' != 'true'">
    <PropertyGroup>
      <_SetupProject>$(MSBuildProjectDirectory)\setup\LinkScope.Setup.csproj</_SetupProject>
      <_SetupStage>$(MSBuildProjectDirectory)\setup\bin\$(Configuration)\</_SetupStage>
      <_SetupDestination>$(TargetDir)LinkScopeSetup.exe</_SetupDestination>
      <_SetupMsi>$(MSBuildProjectDirectory)\deploy\clamav-latest.msi</_SetupMsi>
      <_SetupSig>$(_SetupMsi).sig</_SetupSig>
    </PropertyGroup>
    <Message Text="Building LinkScopeSetup.exe from $(TargetPath)" Importance="high" />
    <Error Condition="!Exists('$(TargetPath)')" Text="Cannot build LinkScope Setup: compiled LinkScope.exe was not found at $(TargetPath)." />
    <Delete Files="$(_SetupDestination)" />
    <MSBuild Projects="$(_SetupProject)" Targets="Rebuild"
             Properties="Configuration=$(Configuration);Platform=x64;LinkScopePayload=$(TargetPath);OutputPath=$(_SetupStage);OutDir=$(_SetupStage)"
             RemoveProperties="TargetFramework;TargetFrameworkVersion;TargetFrameworkIdentifier;TargetFrameworkProfile;PlatformTarget;AssemblyName;TargetName;TargetExt;IntermediateOutputPath;BaseIntermediateOutputPath;MSBuildProjectExtensionsPath;StartupObject;OutputType;ApplicationIcon;DesignTimeBuild;SkipCompilerExecution;BuildingProject;BuildProjectReferences"
             BuildInParallel="false" />
    <Error Condition="!Exists('$(_SetupStage)LinkScopeSetup.exe')" Text="Setup compilation did not produce LinkScopeSetup.exe." />
    <Copy SourceFiles="$(_SetupMsi)" DestinationFolder="$(TargetDir)deploy" SkipUnchangedFiles="true" Condition="Exists('$(_SetupMsi)')" />
    <Copy SourceFiles="$(_SetupSig)" DestinationFolder="$(TargetDir)deploy" SkipUnchangedFiles="true" Condition="Exists('$(_SetupSig)')" />
    <Copy SourceFiles="$(_SetupStage)LinkScopeSetup.exe" DestinationFiles="$(_SetupDestination)" />
    <Error Condition="!Exists('$(_SetupDestination)')" Text="LinkScope Setup output is missing: $(_SetupDestination)." />
    <Message Text="Setup generated: $(_SetupDestination)" Importance="high" />
  </Target>
  <Target Name="CleanLinkScopeSetup" AfterTargets="Clean" Condition="'$(DesignTimeBuild)' != 'true'">
    <Delete Files="$(TargetDir)LinkScopeSetup.exe" Condition="'$(TargetDir)' != ''" />
    <Delete Files="$(MSBuildProjectDirectory)\bin\$(Configuration)\LinkScopeSetup.exe" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)\setup\bin\$(Configuration);$(MSBuildProjectDirectory)\setup\obj\$(Configuration)" />
  </Target>
